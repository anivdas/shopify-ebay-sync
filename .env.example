# Everything below is OPTIONAL. The easiest way to configure the app is the setup
# wizard in your browser. Values set here override what is saved in the UI
# (handy for advanced setups / secrets managers).

# ---- App ----
# PORT=8080
# DATA_DIR=./data
# URL you use to reach the app. If it is https, eBay sign-in can redirect back automatically.
# PUBLIC_URL=https://sync.example.com
# Set to true when served over HTTPS (marks the login cookie Secure)
# COOKIE_SECURE=false
# Set to true ONLY behind a reverse proxy / Cloudflare Tunnel (trusts CF-Connecting-IP / X-Forwarded-For)
# TRUST_PROXY=false
# Set the dashboard password here instead of in the UI
# APP_PASSWORD=
# The first password can only be created from a private network (LAN, Tailscale, Docker). Set to true to allow it from anywhere.
# ALLOW_REMOTE_SETUP=false
# Encryption key for stored tokens (auto-generated into DATA_DIR/secret.key if not set)
# APP_SECRET=

# ---- Shopify ----
# SHOPIFY_SHOP=my-store
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Legacy admin-created custom apps only:
# SHOPIFY_ACCESS_TOKEN=
# Only if webhooks are signed with a different secret than the client secret:
# SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_API_VERSION=2026-10

# ---- eBay ----
# EBAY_ENV=production
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RUNAME=
